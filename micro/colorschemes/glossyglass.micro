# GlossyGlass: inherit the terminal background for transparency.
color-link default "default"
color-link comment "#94868e"
color-link comment.bright "#bfaeb4"
color-link identifier "#c0cfea"
color-link identifier.class "#a2c8c8"
color-link identifier.var "#eadfe2"
color-link constant "#dec49e"
color-link constant.number "#dec49e"
color-link constant.bool "#c9a6cc"
color-link constant.string "#bedbc0"
color-link constant.specialChar "#a2c8c8"
color-link constant.string.url "underline #a2c8c8"
color-link statement "bold #ffb0b8"
color-link symbol "#dec49e"
color-link symbol.operator "#dec49e"
color-link symbol.brackets "#ecb0bb"
color-link symbol.tag "#ffb0b8"
color-link preproc "#c9a6cc"
color-link type "#a2c8c8"
color-link type.keyword "#ffb0b8"
color-link special "#c9a6cc"
color-link underlined "underline #a2c8c8"
color-link error "bold #ff7f91"
color-link todo "bold #dec49e"
color-link selection "#fff0f2,#59343e"
color-link statusline "#f4dfe1,#302127"
color-link statusline.inactive "#bfaeb4,#100d10"
color-link statusline.suggestions "#eadfe2,#302127"
color-link tabbar "#bfaeb4,#100d10"
color-link tabbar.active "bold #ffb0b8,#302127"
color-link indent-char "#64555e"
color-link line-number "#94868e"
color-link current-line-number "bold #ffb0b8"
color-link gutter-info "#a2c8c8"
color-link gutter-error "#ff7f91"
color-link gutter-warning "#dec49e"
color-link diff-added "#bedbc0"
color-link diff-modified "#dec49e"
color-link diff-deleted "#ff7f91"
color-link cursor-line ",#181217"
color-link color-column ",#211b20"
color-link scrollbar "#94868e,#100d10"
color-link divider "#59343e"
color-link message "#bedbc0"
color-link error-message "bold #ff7f91"
color-link match-brace "bold #ffb0b8,#302127"
color-link hlsearch "#fff0f2,#59343e"
color-link tab-error ",#59343e"
color-link trailingws ",#59343e"
