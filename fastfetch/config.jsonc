{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "position": "auto",
        "padding": { "left": 0, "right": 3 },
        "color": { "1": "#ffb0b8", "2": "#ec939e" }
    },
    "display": {
        "separator": ": ",
        "color": { "keys": "#ffb0b8", "title": "#a2c8c8" }
    },
    "modules": [
        "title", "separator", "os", "kernel", "uptime", "shell", "terminal",
        "wm", "cpu", "gpu", "memory", "disk"
    ]
}
